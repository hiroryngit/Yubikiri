# ===========================================
# Supabase（必須）
# ===========================================
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# サイト設定（必須）
# ===========================================
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# ===========================================
# 暗号化（必須）
# ===========================================
# 同意書のタイトル・内容をAES-GCMで暗号化するためのシークレット
# 生成: openssl rand -hex 32
APP_ENCRYPTION_SECRET=your-256bit-hex-string

# ===========================================
# Cronジョブ（Vercelデプロイ時に必須）
# ===========================================
# 生成: openssl rand -hex 32
CRON_SECRET=your-cron-secret

# ===========================================
# OAuth認証（少なくとも1つのプロバイダーが必要）
# ===========================================

# Google OAuth
# https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Discord OAuth
# https://discord.com/developers/applications
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# LINE Login
# https://developers.line.biz/console/
NEXT_PUBLIC_LINE_CHANNEL_ID=your-line-channel-id
LINE_CHANNEL_ID=your-line-channel-id
LINE_CHANNEL_SECRET=your-line-channel-secret

# ===========================================
# AI翻訳（任意 - いずれか1つ以上で翻訳機能が有効化）
# 複数設定するとフォールバックとして機能
# ===========================================
GROQ_API_KEY=your-groq-api-key
CEREBRAS_API_KEY=your-cerebras-api-key
SILICONFLOW_API_KEY=your-siliconflow-api-key
GITHUB_MODELS_API_KEY=your-github-models-api-key

# ===========================================
# Push通知（任意 - PWA通知機能に必要）
# ===========================================
# 生成: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
